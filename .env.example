# Base de donnees (PostgreSQL)
DATABASE_URL="postgresql://orbit:orbit@localhost:5432/orbit?schema=public"

# Secret utilise pour signer les JWT de session (chaine aleatoire longue en production)
JWT_SECRET="change-me-to-a-long-random-string"

# Duree de vie du token de session, en secondes (7 jours par defaut)
JWT_EXPIRES_IN_SECONDS=604800

NODE_ENV="development"
